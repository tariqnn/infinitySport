{
  "name": "infinity-sports",
  "private": true,
  "version": "0.1.0",
  "description": "Infinity Sports monorepo (web, admin, portal) with shared packages",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run prisma:generate || echo 'Prisma generate skipped (prisma not available)'",
    "build": "npm run prisma:generate && next build",
    "start": "next start",
    "start:combined": "node start-combined.js",
    "dev": "npm run dev:web",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:admin": "npm --workspace apps/admin run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:portal": "npm --workspace apps/portal run dev",
    "build:all": "npm run build:web && npm run build:admin && npm run build:portal",
    "build:web": "npm --workspace apps/web run build",
    "build:admin": "npm --workspace apps/admin run build",
    "build:portal": "npm --workspace apps/portal run build",
    "build:api": "npm --workspace apps/api run build",
    "lint": "npm run lint:web && npm run lint:admin && npm run lint:portal",
    "lint:web": "npm --workspace apps/web run lint",
    "lint:admin": "npm --workspace apps/admin run lint",
    "lint:portal": "npm --workspace apps/portal run lint",
    "format": "npm --workspace apps/web run lint -- --fix && npm --workspace apps/admin run lint -- --fix && npm --workspace apps/portal run lint -- --fix",
    "prisma:generate": "npx prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:seed": "cd prisma && ts-node --project tsconfig.json seed.ts",
    "prisma:seed-blocked-slots": "cd prisma && ts-node --project tsconfig.json seed-blocked-slots.ts",
    "prisma:seed-bookings": "cd prisma && ts-node --project tsconfig.json seed-bookings.ts",
    "prisma:seed-basketball-academy-blocks": "cd prisma && ts-node --project tsconfig.json seed-basketball-academy-blocks.ts",
    "prisma:seed-club-bookings": "cd prisma && ts-node --project tsconfig.json seed-club-bookings.ts",
    "prisma:seed-package-pricing": "cd prisma && ts-node --project tsconfig.json seed-package-pricing.ts",
    "prisma:seed-packages": "cd prisma && ts-node --project tsconfig.json seed-packages.ts",
    "start:api": "npm --workspace apps/api run start",
    "start:portal": "npm --workspace apps/portal run start",
    "start:admin": "npm --workspace apps/admin run start",
    "start:web": "npm --workspace apps/web run start",
    "build:hostinger": "npm install && npm run prisma:generate && npm run build:api && npm run build:web",
    "build:hostinger:web-only": "node build-web-only.js",
    "start:hostinger": "node start-combined.js",
    "start:hostinger:web-only": "node start-web-only.js",
    "prisma:studio": "npx prisma studio --schema=./prisma/schema.prisma",
    "db:setup": "npm run prisma:generate && npm run prisma:migrate && npm run prisma:seed"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@infinity/mock-api": "file:./packages/mock-api",
    "@infinity/types": "file:./packages/types",
    "@infinity/ui": "file:./packages/ui",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "next": "15.1.9",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "react": "19.0.0-rc-66855b96-20241106",
    "react-dom": "19.0.0-rc-66855b96-20241106",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@next/swc-wasm-nodejs": "^15.0.3",
    "@swc/helpers": "^0.5.18",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.1.0",
    "ffmpeg-static": "^5.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "overrides": {
    "react": "19.0.0-rc-66855b96-20241106",
    "react-dom": "19.0.0-rc-66855b96-20241106",
    "@swc/helpers": "^0.5.18",
    "fontkit": {
      "@swc/helpers": "0.3.13"
    }
  }
}
