{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["seed.ts", "seed-blocked-slots.ts", "seed-bookings.ts", "seed-basketball-academy-blocks.ts"],
  "exclude": ["node_modules"]
}

