generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HeroSection {
  id                 String   @id @default(cuid())
  title              String
  subtitle           String
  primaryCta         String
  primaryUrl         String
  secondaryCta       String?
  secondaryUrl       String?
  backgroundImageUrl String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  backgroundVideoUrl String?
}

model Program {
  id          String    @id @default(cuid())
  name        String
  description String
  level       String?
  slug        String    @unique
  highlight   Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
}

model LandingCoach {
  id           String   @id @default(cuid())
  name         String
  sport        String
  description  String
  quote        String?
  achievements String[] @default([])
  imageUrl     String
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([order])
  @@index([isActive])
}

model Offer {
  id            String         @id @default(cuid())
  name          String
  pricePerMonth Int
  badge         String?
  description   String
  features      String[]
  order         Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  location    String
  highlight   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imageUrl    String?
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  publishedAt DateTime @default(now())
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imageUrl    String?
}

model FacilityHighlight {
  id          String    @id @default(cuid())
  name        String
  description String
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  order       Int       @default(0)
  bookings    Booking[]
}

model FooterLink {
  id        String   @id @default(cuid())
  label     String
  url       String
  group     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FooterSettings {
  id                    String   @id @default(cuid())
  address               String
  phone                 String
  email                 String
  contactRecipientEmail String?
  socialLinks           Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Company {
  id                    String                 @id @default(cuid())
  name                  String
  contactName           String
  contactEmail          String
  phone                 String?
  industry              String?
  size                  String?
  status                CompanyStatus          @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  bookings              Booking[]
  budgetCategories      BudgetCategory[]
  budgetEntries         BudgetEntry[]
  cashBookCategories    CashBookCategory[]
  cashBookTransactions  CashBookTransaction[]
  cashFlowEntries       CashFlowEntry[]
  classes               Class[]
  coaches               Coach[]
  settings              CompanySettings?
  inventory             InventoryItem[]
  invoices              Invoice[]
  members               Member[]
  pettyCashTransactions PettyCashTransaction[]
  PortalShopItem        PortalShopItem[]
  staffTasks            StaffTask[]
  subscriptions         Subscription[]
  User                  User[]
}

model Member {
  id            String            @id @default(cuid())
  companyId     String
  email         String?
  phone         String?
  status        MemberStatus      @default(ACTIVE)
  guardianName  String?
  guardianPhone String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  dateOfBirth   DateTime?
  firstName     String
  lastName      String
  notes         String?
  bookings      Booking[]
  enrollments   ClassEnrollment[]
  invoices      Invoice[]
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  User          User?

  @@index([companyId])
  @@index([email])
}

model Booking {
  id                           String                        @id @default(cuid())
  companyId                    String
  programId                    String?
  facilityId                   String?
  memberId                     String?
  startTime                    DateTime
  endTime                      DateTime
  status                       BookingStatus                 @default(PENDING)
  notes                        String?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  classId                      String?
  coachId                      String?
  facilityArea                 String?
  isPaid                       Boolean                       @default(false)
  customerName                 String?
  customerPhone                String?
  customerEmail                String?
  class                        Class?                        @relation(fields: [classId], references: [id])
  coach                        Coach?                        @relation(fields: [coachId], references: [id])
  company                      Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  facility                     FacilityHighlight?            @relation(fields: [facilityId], references: [id])
  member                       Member?                       @relation(fields: [memberId], references: [id])
  program                      Program?                      @relation(fields: [programId], references: [id])
  BookingPayment               BookingPayment[]
  BookingRewardPointAdjustment BookingRewardPointAdjustment?

  @@index([companyId])
  @@index([startTime])
  @@index([status])
  @@index([classId])
  @@index([coachId])
}

model User {
  id           String    @id @default(cuid())
  companyId    String
  memberId     String?   @unique
  fullName     String
  email        String?   @unique
  phone        String?
  password     String
  role         UserRole  @default(MEMBER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  name         String?
  isActive     Boolean   @default(true)
  passwordHash String?
  receipts     Receipt[]
  Company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Member       Member?   @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([email])
  @@index([isActive])
  @@index([companyId])
}

model BlockedSlot {
  id        String    @id @default(cuid())
  dayOfWeek String
  courtType String
  time      String
  isBlocked Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  label     String?
  startDate DateTime?
  endDate   DateTime?

  @@unique([dayOfWeek, courtType, time])
  @@index([dayOfWeek])
  @@index([courtType])
  @@index([label])
}

model Subscription {
  id        String             @id @default(cuid())
  companyId String
  offerId   String
  memberId  String?
  startDate DateTime
  endDate   DateTime?
  status    SubscriptionStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  invoices  Invoice[]
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  member    Member?            @relation(fields: [memberId], references: [id])
  offer     Offer              @relation(fields: [offerId], references: [id])

  @@index([companyId])
  @@index([memberId])
  @@index([status])
}

model Invoice {
  id              String          @id @default(cuid())
  companyId       String
  subscriptionId  String?
  number          String          @unique
  amount          Int
  currency        String          @default("JOD")
  status          InvoiceStatus   @default(DRAFT)
  dueDate         DateTime?
  issuedAt        DateTime        @default(now())
  paidAt          DateTime?
  description     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  memberId        String?
  amountPaid      Int             @default(0)
  companyEmail    String?
  companyPhone    String?
  note            String?
  companyName     String?
  companyAddress  String?
  logoPath        String?
  clientName      String?
  clientEmail     String?
  clientAddress   String?
  lineItems       Json?
  subtotal        Int?
  tax             Int?
  discount        Int?
  notes           String?
  pdfPath         String?
  cashFlowEntries CashFlowEntry[]
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  member          Member?         @relation(fields: [memberId], references: [id])
  subscription    Subscription?   @relation(fields: [subscriptionId], references: [id])

  @@index([companyId])
  @@index([memberId])
  @@index([status])
  @@index([number])
}

model BudgetCategory {
  id          String        @id @default(cuid())
  companyId   String
  name        String
  description String?
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  budgets     BudgetEntry[]

  @@index([companyId])
  @@index([order])
}

model BudgetEntry {
  id            String         @id @default(cuid())
  companyId     String
  categoryId    String
  periodStart   DateTime
  periodEnd     DateTime
  plannedAmount Int
  actualAmount  Int            @default(0)
  currency      String         @default("JOD")
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  category      BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([categoryId])
  @@index([periodStart])
  @@index([periodEnd])
}

model CashFlowEntry {
  id               String       @id @default(cuid())
  companyId        String
  date             DateTime
  type             CashFlowType
  category         String?
  amount           Int
  currency         String       @default("JOD")
  relatedInvoiceId String?
  description      String?
  createdAt        DateTime     @default(now())
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  relatedInvoice   Invoice?     @relation(fields: [relatedInvoiceId], references: [id])

  @@index([companyId])
  @@index([date])
  @@index([type])
  @@index([relatedInvoiceId])
}

model PettyCashTransaction {
  id           String        @id @default(cuid())
  companyId    String
  date         DateTime
  item         String
  staff        String?
  amount       Int
  currency     String        @default("JOD")
  type         PettyCashType
  balanceAfter Int
  reference    String?
  description  String?
  createdAt    DateTime      @default(now())
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([date])
  @@index([type])
}

model CashBookCategory {
  id           String                  @id @default(cuid())
  companyId    String
  name         String
  type         CashBookTransactionType
  isDefault    Boolean                 @default(false)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @default(now()) @updatedAt
  company      Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions CashBookTransaction[]

  @@unique([companyId, type, name])
  @@index([companyId])
  @@index([type])
}

model CashBookTransaction {
  id             String                  @id @default(cuid())
  companyId      String
  type           CashBookTransactionType
  categoryId     String?
  categoryName   String
  amount         Int
  note           String?
  date           DateTime
  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  attachmentSize Int?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @default(now()) @updatedAt
  category       CashBookCategory?       @relation(fields: [categoryId], references: [id])
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([type])
  @@index([categoryId])
  @@index([date])
}

model Coach {
  id        String      @id @default(cuid())
  companyId String
  firstName String
  lastName  String
  email     String?
  phone     String?
  specialty String?
  bio       String?
  status    CoachStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  bookings  Booking[]
  classes   Class[]
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
}

model Class {
  id          String            @id @default(cuid())
  companyId   String
  name        String
  description String?
  coachId     String?
  startTime   DateTime
  endTime     DateTime
  capacity    Int
  status      ClassStatus       @default(SCHEDULED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  bookings    Booking[]
  coach       Coach?            @relation(fields: [coachId], references: [id])
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  enrollments ClassEnrollment[]

  @@index([companyId])
  @@index([coachId])
  @@index([startTime])
  @@index([status])
}

model ClassEnrollment {
  id        String   @id @default(cuid())
  classId   String
  memberId  String
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([classId, memberId])
  @@index([classId])
  @@index([memberId])
}

model InventoryItem {
  id        String          @id @default(cuid())
  companyId String
  name      String
  category  String?
  quantity  Int
  location  String?
  status    InventoryStatus @default(AVAILABLE)
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([category])
}

model StaffTask {
  id          String     @id @default(cuid())
  companyId   String
  title       String
  description String?
  assignedTo  String?
  dueDate     DateTime?
  status      TaskStatus @default(OPEN)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([assignedTo])
}

model CompanySettings {
  id                String   @id @default(cuid())
  companyId         String   @unique
  timezone          String?
  bookingWindowDays Int?
  notifyEmail       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model PackagePricing {
  id           String   @id @default(cuid())
  packageName  String   @unique
  basePriceJod Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([packageName])
}

model Package {
  id                 String   @id @default(cuid())
  sportType          String
  name               String   @unique
  description        String?
  descriptionBullets Json?
  sessionsCount      Int      @default(0)
  trackingType       String   @default("SESSIONS")
  pricingType        String   @default("FIXED")
  currentPriceJod    Int?
  timeSlots          Json?
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
  durationMonths     Int      @default(1)
  showOnWebsite      Boolean  @default(true)

  @@index([sportType])
  @@index([isActive])
  @@index([sortOrder])
}

model PackageRegistration {
  id                          String                        @id @default(cuid())
  packageName                 String
  customerName                String
  customerPhone               String
  customerEmail               String?
  isPaid                      Boolean                       @default(false)
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  customerAge                 Int?
  periodEndsAt                DateTime?
  isFrozen                    Boolean                       @default(false)
  frozenAt                    DateTime?
  sessionsBonus               Int                           @default(0)
  basePriceJod                Int
  discountType                String                        @default("NONE")
  discountValue               Int?
  discountReason              String?
  finalPriceJod               Int
  discountAppliedBy           String?
  discountAppliedAt           DateTime?
  billingPeriodKey            String?
  priceLockedUntil            DateTime?
  status                      String                        @default("ACTIVE")
  periodStartsAt              DateTime?
  sessionsLeft                Int?
  sessionsUsedOverride        Int?
  nextPaymentDate             DateTime?                     @db.Timestamptz(6)
  planLabel                   String?
  durationMonths              Int                           @default(1)
  receipts                    Receipt[]
  RegistrationPointAdjustment RegistrationPointAdjustment[]
  RegistrationProfile         RegistrationProfile?
  RegistrationRenewalHistory  RegistrationRenewalHistory[]
  sessionAdjustments          SessionAdjustment[]

  @@index([packageName])
  @@index([isPaid])
  @@index([periodEndsAt])
  @@index([status])
}

model Receipt {
  id               String              @id @default(cuid())
  receiptId        String              @unique
  registrationId   String
  personName       String
  personPhone      String
  packageName      String
  dateTimeIssued   DateTime            @default(now())
  paymentPeriodKey String?
  amountPaid       Int
  paymentMethod    String
  privateNote      String
  createdBy        String?
  voidedAt         DateTime?
  voidReason       String?
  createdAt        DateTime            @default(now())
  status           String              @default("ACTIVE")
  userId           String?
  cycleNumber      Int                 @default(1)
  registration     PackageRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user             User?               @relation(fields: [userId], references: [id])

  @@index([registrationId])
  @@index([receiptId])
  @@index([status])
  @@index([userId])
  @@index([paymentPeriodKey])
  @@index([registrationId, cycleNumber], map: "Receipt_registration_cycle_idx")
}

model SessionAdjustment {
  id             String              @id @default(cuid())
  registrationId String
  change         Int
  reason         String
  createdBy      String?
  createdAt      DateTime            @default(now())
  cycleNumber    Int                 @default(1)
  registration   PackageRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([registrationId, cycleNumber], map: "SessionAdjustment_registration_cycle_idx")
}

model PackageSessionCanceled {
  id           String   @id @default(cuid())
  packageName  String
  sessionDate  DateTime @db.Date
  reason       String
  reasonDetail String?
  createdAt    DateTime @default(now())

  @@index([packageName])
  @@index([sessionDate])
}

model CompetitionRegistration {
  id              String   @id @default(cuid())
  competitionType String
  participantName String?
  age             Int?
  gender          String?
  customerPhone   String?
  teamName        String?
  playerOne       String?
  playerTwo       String?
  playerThree     String?
    playerFour      String?
    isPaid          Boolean  @default(false)
    amountDue       Int?
    amountPaid      Int?
    paymentMethod   String?
  paidAt          DateTime?
  source          String   @default("WEBSITE")
  status          String   @default("NEW")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([competitionType])
  @@index([createdAt])
  @@index([isPaid])
  @@index([status])
}

model AvailabilityException {
  id        String   @id
  courtType String
  date      DateTime @db.Date
  openTime  String?
  closeTime String?
  isClosed  Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([courtType, date], map: "AvailabilityException_court_date_idx")
}

model BookingAuditLog {
  id               String   @id
  bookingId        String?
  action           String
  payload          Json?
  createdByAdminId String?
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  @@index([bookingId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model BookingPayment {
  id               String   @id
  bookingId        String
  customerId       String?
  amount           Int
  method           String
  status           String   @default("PAID")
  transactionRef   String?
  createdByAdminId String?
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @db.Timestamptz(6)
  Booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([bookingId])
  @@index([createdAt])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model BookingRewardPointAdjustment {
  id            String   @id
  bookingId     String   @unique
  customerEmail String
  change        Int
  reason        String
  source        String
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  Booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model CourtRate {
  courtType           String   @id
  hourlyRate          Int
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @db.Timestamptz(6)
  rewardPointsPerHour Int      @default(10)
}

model GuestAccountDeletion {
  customerEmail String   @id
  deletedAt     DateTime @default(now()) @db.Timestamptz(6)

  @@index([deletedAt])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model GuestPointAdjustment {
  id            String   @id
  customerEmail String
  change        Int
  reason        String
  createdBy     String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model PortalShopItem {
  id                String   @id
  companyId         String
  name              String
  category          String?
  description       String?
  imageUrl          String?
  pointsCost        Int
  quantityAvailable Int?
  status            String   @default("ACTIVE")
  isFeatured        Boolean  @default(false)
  redemptionNote    String?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @db.Timestamptz(6)
  Company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([companyId])
  @@index([sortOrder])
  @@index([status])
}

model RegistrationPointAdjustment {
  id                  String              @id
  registrationId      String
  change              Int
  reason              String
  createdBy           String?
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  PackageRegistration PackageRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt])
  @@index([registrationId])
}

model RegistrationProfile {
  registrationId      String              @id
  playerCode          String              @unique
  currentCycle        Int                 @default(1)
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime            @default(now()) @db.Timestamptz(6)
  PackageRegistration PackageRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([playerCode])
}

model RegistrationRenewalHistory {
  id                  String              @id
  registrationId      String
  playerCode          String
  cycleNumber         Int
  action              String              @default("REREGISTERED")
  snapshot            Json?
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  PackageRegistration PackageRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([registrationId])
}

model WorkingHours {
  id        String   @id
  courtType String
  dayOfWeek Int
  openTime  String   @default("07:00")
  closeTime String   @default("23:59")
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([courtType, dayOfWeek])
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TRIAL
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  FROZEN
  EXPIRED
}

enum CoachStatus {
  ACTIVE
  INACTIVE
}

enum ClassStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

