{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@infinity/types": [
        "../../packages/types/src"
      ],
      "@infinity/mock-api": [
        "../../packages/mock-api/src"
      ]
    },
    "jsx": "preserve"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-admin/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
